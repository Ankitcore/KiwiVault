# Kiwi Vault — Environment Configuration Example
# Copy to .env.local for live blockchain & Supabase integration.
# If omitted, Kiwi Vault automatically runs in deterministic Demo Verification Mode.

# Polygon Amoy (80002) or Ethereum Sepolia (11155111)
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CONTRACT_ADDRESS=0x7F29A3C18B421465B72485D22E00000000RVSCET

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
